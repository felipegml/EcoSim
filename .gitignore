@'
# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Frontend dependencies and build output
node_modules/
frontend/dist/

# Logs
*.log
'@ | Set-Content -Encoding utf8 .gitignore